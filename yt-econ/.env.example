# ============================================================
#  yt-econ 環境変数テンプレート  ( cp .env.example .env )
# ============================================================

# --- Claude API（台本・話題選定・メタデータ生成）※必須 ---
ANTHROPIC_API_KEY=sk-ant-...

# --- 音声合成 ---
# voicevox / google / none のいずれか（config/channel.yaml の tts.provider と合わせる）
# VOICEVOX はローカル起動した無料エンジンを使う（APIキー不要）
VOICEVOX_URL=http://127.0.0.1:50021
# Google Cloud TTS を使う場合のみ
GOOGLE_APPLICATION_CREDENTIALS=

# --- 素材（任意・無くても動く） ---
# https://www.pexels.com/api/ で無料取得
PEXELS_API_KEY=

# --- YouTube Data API v3 ---
# Google Cloud Console で OAuth クライアント(デスクトップ)を作成して取得
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# scripts/auth_youtube.py を一度実行すると出力される。CI ではこれを Secret に入れる
YOUTUBE_REFRESH_TOKEN=
